# ==============================================================================
# 1. PYTHON RUNTIMES & ENVIRONMENT EXCLUSIONS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.pyc

# ==============================================================================
# 2. BINARY EXECUTABLES & PRE-COMPILED DYNAMIC LIBRARIES (THE FREEZE CULPRITS)
# ==============================================================================
*.dll
*.exe
*.bin
*.dylib

# ==============================================================================
# 3. COMPRESSED ARCHIVES & RELEASE CONFIGURATIONS
# ==============================================================================
# Ignore all zip files by default
*.zip
# FORCE tracking of your specific PowerShell release script (Added slash for root precision)
!/create_release_zip.ps1

# ==============================================================================
# 4. MASSIVE ASTRONOMICAL DATA, MEDIA & LOGS
# ==============================================================================
*.fits
*.fit
*.ser
*.avi
*.mp4
*.png
*.jpg
*.jpeg
*.ico
*.log
*_debug.log
debug.log
owc_data_debug.log

# ==============================================================================
# 5. DOCUMENTATION & PROPRIETARY OFFICE FORMATS
# ==============================================================================
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.csv

# ==============================================================================
# 6. IDE, TEMPORARY SYSTEM FILES & DATA HOARDS
# ==============================================================================
.vscode/
.idea/
.project
*.swp
*.swo
*~
.DS_Store
Thumbs.db
test_output/

# ==============================================================================
# 7. PROJECT-SPECIFIC LOCAL RUNTIME DATA & REPORTS
# ==============================================================================
occultation-manager/temp_release/
occultation-manager/data/config/occultation_config.json
occultation-manager/data/events/occultations.json
occultation-manager/data/events/occultations_latest.json
