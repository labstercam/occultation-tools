# SharpCap Occultation Template
# Michael Camilleri
# This uses Local Time for a less complex template script
# HOWEVER IT HAS RISKS:
# - Risks problems with timezones, daylight savings etc, so BE CAREFUL.
# - Does not know what day it is
# - Can use WAIT UNTIL LOCALTIME, but if you start late it wait be another 24 hours
# - Can use WAIT UNTIL LATER THAN LOCALTIME which will start if it is already past the time so at least it wil keep running and not mess up the events following
# - but it doesn't know when night time is so if you, say, have a start time after local midnight it will start IMMEDIATELY and you will miss the event
# - So you MUST use a WAIT UNTIL EVENT Sunset or similar so that it waits until nighttime.
# This template can only run events on the current night - it can't wait for future days.
# Add a DELAY of 86400 seconds for each days delay required, or use the other templates that use UTC date and time

# Define steps to safely finish the observation and leave it ready for the next observation. e.g. move to a safe position, or park. Could turn off camera etc.
# Will run even if there is an error. 
DEF SUB safe_finish
        SET GAIN TO 90
        SET RESOLUTION TO 1936x1096
        MOUNT GOTO ALTAZ 30 270
        MOUNT TRACKING None
END SUB    

SEQUENCE
    #Asteroid (165690) 2001 PA3 at 2025-12-23T09:28:50
    #Star Mag: 13.7;	Combined Mag: 13.7; Mag Drop: 5.7
    #Predict Time 2025-12-23T09:28:50; Error In Time: 0.8
    #MaxDuration: %MaxDuration%; Probability: %Probability%

    
# Customise these to your setup
# Focal length in mm for platesolving
    SET FOCALLEN TO 660
# Your preferred output format     
    SET OUTPUT FORMAT TO "ADV files (*.adv)"     
# Full screen or resolution to use for plate solving
    SET RESOLUTION TO 1936x1096
# Get the mount moving if parked
    MOUNT TRACKING Sidereal
# A gain and exposure that will be pleasant to look at and not overwork the camera whilst waiting
# You could turn the camera off, but leaving it on gives some cold protection
    SET GAIN TO 90
    SET EXPOSURE TO 0.250
    DELAY 1
    DISPLAY STRETCH AUTO

# Wait until the Sunset or a specified event (AstronomicalDarkness - see the SharpCap sequencer) or specify a time
# MUST have one these steps otherwise if the event local time is after midnight it will start goto and recording IMMEDIATELY!
    WAIT UNTIL LATER THAN LOCALTIME "06:00:00 PM"
#    WAIT UNTIL EVENT Sunset
# Display a notification until the GOTO time
    LOOP UNTIL LATER THAN LOCALTIME "10:22:50 PM"
        SHOW NOTIFICATION "Waiting for GOTO (165690) 2001 PA3 at 10:24:20 PM " COLOUR Green DURATION 58
        DELAY 59
    END LOOP
    SHOW NOTIFICATION "Waiting for GOTO (165690) 2001 PA3 at 10:24:20 PM " COLOUR Green DURATION 25

# Wait until the GOTO time, which is 4 mins before event time plus 3 times the time error
# Optionally can skip if it is too late. This will only GOTO if it is before the event start time
IF EARLIER THAN LOCALTIME "10:28:20 PM"
    # If you start late this will run anyway
    WAIT UNTIL LATER THAN LOCALTIME "10:24:20 PM"

    # GOTO and PLATESOLVE. If an error it should run SUB safe_finish to move the mount to its defined safe position
    IGNORE ERRORS FROM ONERROR RUN safe_finish
        SET PLATESOLVE/FOCUS SETTINGS EXPOSURE 4
            SET GAIN TO 450
            SET EXPOSURE TO 0.5
	    DELAY 1
            DISPLAY STRETCH AUTO
            RETRY ERRORS UP TO 1 TIMES
                MOUNT GOTO "2.293182 26.934360"
                MOUNT SOLVEANDSYNC
            END RETRY ERRORS
        END SET
    END IGNORE ERRORS
END IF

# Setup for the event
    TARGETNAME "(165690) 2001 PA3"

# CHange the exposure and gain to suit the event mag and duration. Change this to suit the reach of your camera and scope.
# Controlled by exposure paramete from the Occultation Manager tool
    SET RESOLUTION TO 816x822
    SET GAIN TO 450
    SET EXPOSURE TO 0.320
    DELAY 2
    DISPLAY STRETCH AUTO

# Record
# Wait until the recording start time
# If you start late it will record anyway
    SHOW NOTIFICATION "Waiting for recording start at 10:28:20 PM " COLOUR Green DURATION 58
    WAIT UNTIL LATER THAN LOCALTIME "10:28:20 PM"
    CAPTURE 60 SECONDS LIVE FRAMES
    SHOW NOTIFICATION "Recording Complete. Reseting camera and parking mount in safe position if required." COLOUR GREEN DURATION 30

## Optionally can skip if it is too late. This will only record if it is before the event mid time
#    IF EARLIER THAN LOCALTIME "10:28:50 PM"
#        WAIT UNTIL LATER THAN LOCALTIME "10:28:20 PM"
#        CAPTURE 60 SECONDS LIVE FRAMES
#        SHOW NOTIFICATION "Recording Complete. Reseting camera and parking mount in safe position if required." COLOUR GREEN DURATION 30
#    END IF

# run safe_finish to end    
    BEFORE SEQUENCE FINISH DO
        GOSUB safe_finish
    END DO
END SEQUENCE
